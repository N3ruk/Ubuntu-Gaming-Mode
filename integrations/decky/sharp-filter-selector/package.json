{
  "name": "sharp-filter-selector",
  "version": "1.1.0",
  "description": "Decky Loader plugin for dynamically switching Gamescope Sharp scaling between SGSR, FSR and NIS.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "package": "bash scripts/package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N3ruk/Sharp-Filter-Selector.git"
  },
  "keywords": [
    "decky",
    "decky-loader",
    "steam-deck",
    "steamos",
    "gamescope",
    "fsr",
    "nis",
    "sgsr"
  ],
  "author": "N3ruk",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
