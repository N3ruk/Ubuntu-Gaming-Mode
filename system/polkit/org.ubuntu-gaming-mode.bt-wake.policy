<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.ubuntu-gaming-mode.bt-wake.configure">
    <description>Configure Bluetooth controller wake</description>
    <description xml:lang="es">Configurar despertar por mando Bluetooth</description>
    <message>Authentication is required to configure Bluetooth controller wake.</message>
    <message xml:lang="es">Se requiere autenticación para configurar el despertar por mando Bluetooth.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/ubuntu-gaming-mode/ugm-bt-wake</annotate>
  </action>
</policyconfig>
