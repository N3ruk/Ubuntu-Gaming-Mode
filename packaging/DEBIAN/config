#!/bin/sh
set -e

. /usr/share/debconf/confmodule

if command -v gamescope >/dev/null 2>&1; then
    current_gamescope="$(command -v gamescope)"
    current_description="Se ha detectado un comando gamescope en ${current_gamescope}."
else
    current_description="No se ha detectado actualmente ningún comando gamescope en PATH."
fi

db_subst ubuntu-gaming-mode/system-gamescope-command \
    CURRENT_GAMESCOPE "$current_description"

db_input high ubuntu-gaming-mode/console-suspend-button || true
db_input high ubuntu-gaming-mode/system-gamescope-command || true
db_input high ubuntu-gaming-mode/desktop-icon-theme || true
# Decky y el maestro son opcionales; ya no se ofrecen módulos separados.
db_input high ubuntu-gaming-mode/decky-loader || true
# Migrar la selección anterior una sola vez; no volver a activar un rechazo.
db_fget ubuntu-gaming-mode/decky-options seen || true
if [ "${RET:-false}" != true ]; then
    for key in decky-sharp-filter-selector decky-downsampling-sharpener decky-video-output; do
        RET=false
        db_get ubuntu-gaming-mode/$key || true
        if [ "${RET:-false}" = true ]; then
            db_set ubuntu-gaming-mode/decky-options true || true
        fi
    done
fi
db_input high ubuntu-gaming-mode/decky-options || true
# Preguntar solo si el kernel enumera un adaptador Bluetooth USB.
# La BIOS y la prueba física no son detectables desde debconf.
for hci in /sys/class/bluetooth/hci[0-9]*; do
    [ -e "$hci/device" ] || continue
    case "$(readlink -f "$hci/device")" in
        */usb[0-9]*/*)
            db_input high ubuntu-gaming-mode/bluetooth-controller-wake-notice || true
            db_input high ubuntu-gaming-mode/bluetooth-controller-wake-app || true
            break
            ;;
    esac
done
db_go || true

exit 0
