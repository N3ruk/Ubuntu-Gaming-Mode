#!/usr/bin/env python3
"""Install and select the optional UGM desktop icon theme for one user."""
import ast
import json
import os
from pathlib import Path, PurePosixPath
import subprocess
import sys
import tarfile
import tempfile

THEME = 'UGM-ICONS'

def icon_setting(*args):
    p = subprocess.run(['gsettings', *args, 'org.gnome.desktop.interface', 'icon-theme'],
                       capture_output=True, text=True, check=True)
    return p.stdout.strip()

def current_theme():
    return ast.literal_eval(icon_setting('get'))

def set_theme(name):
    subprocess.run(['gsettings', 'set', 'org.gnome.desktop.interface', 'icon-theme', name],
                   check=True)

def valid_archive(archive):
    with tarfile.open(archive, 'r:xz') as source:
        for member in source:
            parts = PurePosixPath(member.name).parts
            if not parts or parts[0] != THEME or '..' in parts or member.name.startswith('/'):
                raise ValueError('Ruta inválida en el archivo de iconos')
            if not (member.isfile() or member.isdir() or member.issym()):
                raise ValueError('Tipo de archivo no admitido en el tema')
            if member.issym():
                resolved = PurePosixPath(*parts[:-1], member.linkname)
                normalized = []
                for part in resolved.parts:
                    if part == '..':
                        if not normalized:
                            raise ValueError('Enlace fuera del tema')
                        normalized.pop()
                    elif part not in ('', '.'):
                        normalized.append(part)
                if not normalized or normalized[0] != THEME:
                    raise ValueError('Enlace fuera del tema')

def data_dir():
    return Path(os.environ.get('XDG_DATA_HOME') or Path.home() / '.local/share')

def state_file():
    return Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'ubuntu-gaming-mode/icon-theme.json'

def enable(archive):
    target = data_dir() / 'icons' / THEME
    state = state_file()
    if not archive.is_file():
        raise FileNotFoundError(archive)
    if target.is_symlink() and not target.exists():
        raise ValueError(f'Enlace de tema roto: {target}')
    prior = current_theme()
    if not target.exists() and not target.is_symlink():
        valid_archive(archive)
        target.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='.ugm-icons-', dir=target.parent) as temp:
            with tarfile.open(archive, 'r:xz') as source:
                source.extractall(temp, filter='data')
            staged = Path(temp) / THEME
            if not (staged / 'index.theme').is_file():
                raise ValueError('Tema incompleto: falta index.theme')
            staged.rename(target)
        print(f'Tema de iconos instalado en {target}')
    else:
        print(f'Tema de iconos ya presente; se conserva: {target}')
    if not state.exists():
        state.parent.mkdir(parents=True, exist_ok=True)
        previous = prior
        tmp = state.with_suffix('.tmp')
        tmp.write_text(json.dumps({'previous_theme': previous}) + '\n')
        tmp.replace(state)
    if prior != THEME:
        set_theme(THEME)
    print(f'Tema {THEME} activo para {Path.home().name}')

def disable():
    state = state_file()
    if not state.exists():
        print('No hay activación de iconos administrada por UGM')
        return
    previous = json.loads(state.read_text())['previous_theme']
    if not isinstance(previous, str) or not previous:
        raise ValueError('Estado de tema anterior inválido')
    if current_theme() == THEME and previous != THEME:
        set_theme(previous)
        print(f'Tema anterior restaurado: {previous}')
    else:
        print('El tema activo se conserva; no coincide con una activación pendiente de UGM')
    state.unlink()
    print('Los archivos de iconos del usuario se conservan para evitar perder cambios propios')

def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ('enable', 'disable'):
        raise ValueError('Uso: ugm-icon-theme enable ARCHIVO.tar.xz | disable')
    if sys.argv[1] == 'enable':
        if len(sys.argv) != 3:
            raise ValueError('Falta el archivo del tema')
        enable(Path(sys.argv[2]))
    elif len(sys.argv) == 2:
        disable()
    else:
        raise ValueError('disable no recibe argumentos')

if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError, tarfile.TarError) as error:
        print(f'ugm-icon-theme: {error}', file=sys.stderr)
        sys.exit(1)
