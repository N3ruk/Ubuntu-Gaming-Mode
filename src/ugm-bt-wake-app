#!/usr/bin/env python3
"""Bluetooth controller wake selector for UGM."""
import json
import subprocess
import sys

import gi
gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk

BACKEND = "/usr/lib/ubuntu-gaming-mode/ugm-bt-wake"
ICON = "/usr/share/icons/hicolor/256x256/apps/ugm-bt-wake.png"
DESKTOP_ID = "ugm-bt-wake"


def backend(*args, privileged=False):
    command = (["pkexec"] if privileged else []) + [BACKEND, *args]
    return subprocess.run(command, capture_output=True, text=True, check=True)


def error_dialog(parent, text):
    dialog = Gtk.MessageDialog(
        transient_for=parent, modal=True, message_type=Gtk.MessageType.ERROR,
        buttons=Gtk.ButtonsType.CLOSE, text="No se pudo cambiar Bluetooth wake")
    dialog.format_secondary_text(text)
    dialog.run()
    dialog.destroy()


def main():
    GLib.set_prgname(DESKTOP_ID)
    Gdk.set_program_class(DESKTOP_ID)
    try:
        status = json.loads(backend("probe").stdout)
    except (OSError, subprocess.CalledProcessError, ValueError) as exc:
        print(f"No se pudo leer el inventario Bluetooth: {exc}", file=sys.stderr)
        return 1

    window = Gtk.Window(title="UGM · Despertar por mando")
    window.set_icon_from_file(ICON)
    window.set_default_size(550, 350)
    window.set_border_width(18)
    window.connect("destroy", Gtk.main_quit)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    window.add(box)

    heading = Gtk.Label()
    heading.set_markup("<b>Despertar desde suspensión por Bluetooth</b>")
    heading.set_xalign(0)
    box.pack_start(heading, False, False, 0)

    intro = Gtk.Label(label=(
        "Selecciona qué mandos emparejados pueden despertar el equipo.\n"
        "La BIOS debe permitir despertar por USB/PCIe. No enciende desde apagado."
    ))
    intro.set_xalign(0)
    intro.set_line_wrap(True)
    box.pack_start(intro, False, False, 0)

    if not status["eligible"]:
        reason = Gtk.Label(label=(
            "La ruta de despertar no está completamente lista. "
            "Puedes cambiar WakeAllowed, pero revisa «ugm-bt-wake probe» antes de probar."
        ))
        reason.set_xalign(0)
        reason.set_line_wrap(True)
        box.pack_start(reason, False, False, 0)

    controllers = []
    for item in status["controllers"]:
        label = item["name"] + " · " + item["path"][-5:].replace("_", ":")
        check = Gtk.CheckButton(label=label)
        check.set_active(item["wake_allowed"])
        check.set_sensitive(item["trusted"])
        box.pack_start(check, False, False, 0)
        controllers.append((item["path"], check, item["wake_allowed"]))
    if not controllers:
        note = Gtk.Label(label="No hay mandos HID emparejados. Empareja uno y vuelve a abrir la app.")
        note.set_xalign(0)
        box.pack_start(note, False, False, 0)

    detail = Gtk.Label(label=(
        "La casilla muestra el estado actual de WakeAllowed. «Aplicar» cambia solo "
        "los mandos modificados. El estado actual no demuestra que la BIOS permita despertar: "
        "compruébalo con una suspensión real."
    ))
    detail.set_xalign(0)
    detail.set_line_wrap(True)
    box.pack_end(detail, False, False, 0)

    button = Gtk.Button(label="Aplicar selección")
    button.set_sensitive(any(check.get_sensitive() for _, check, _ in controllers))
    box.pack_end(button, False, False, 0)

    def apply_selection(_button):
        button.set_sensitive(False)
        try:
            for index, (path, check, original) in enumerate(controllers):
                if check.get_sensitive() and check.get_active() != original:
                    backend("set", path, "on" if check.get_active() else "off", privileged=True)
                    controllers[index] = (path, check, check.get_active())
            info = Gtk.MessageDialog(
                transient_for=window, modal=True, message_type=Gtk.MessageType.INFO,
                buttons=Gtk.ButtonsType.OK, text="Selección aplicada")
            info.format_secondary_text(
                "Prueba el despertar tras suspender; la app no puede verificar la BIOS automáticamente.")
            info.run()
            info.destroy()
        except (OSError, subprocess.CalledProcessError) as exc:
            message = exc.stderr.strip() if isinstance(exc, subprocess.CalledProcessError) else str(exc)
            error_dialog(window, message or "No se pudo aplicar la selección.")
        finally:
            button.set_sensitive(True)

    def refresh_controllers():
        try:
            live = {item["path"]: item for item in json.loads(backend("probe").stdout)["controllers"]}
        except (OSError, subprocess.CalledProcessError, ValueError, KeyError):
            return True
        for index, (path, check, original) in enumerate(controllers):
            item = live.get(path)
            if item is None:
                continue
            current = item["wake_allowed"]
            # Preserve an unapplied edit while refreshing the live baseline.
            if check.get_active() == original:
                check.set_active(current)
            check.set_sensitive(item["trusted"])
            controllers[index] = (path, check, current)
        return True

    button.connect("clicked", apply_selection)
    GLib.timeout_add_seconds(3, refresh_controllers)
    window.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
